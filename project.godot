; Engine configuration file.
; Skate - Android 3D skateboarding prototype (Godot 4.3)

config_version=5

[application]

config/name="Skate"
config/description="A small third-person skateboarding prototype built for Android."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.09, 0.1, 0.13, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/game/GameState.gd"
Controls="*res://scripts/game/Controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

